# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
.env
*.egg-info/
*.db

# Node
node_modules/
dist/
dist-ssr/

# Go: ignore only the compiled binaries. Anchor the paths: the unanchored pattern
# `agent/**/agent` also matched the *directory* agent/cmd/agent and silently kept
# the whole Go source tree out of git.
/agent/agent
/agent/cmd/agent/agent
/agent/**/infra-watch-agent
*.exe

# Logs
*.log
logs/

# IDE
.vscode/
.idea/

# macOS
.DS_Store

# Docker
docker-compose.override.yml

# Build artifacts
*.out